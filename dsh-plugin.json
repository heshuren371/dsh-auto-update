{
  "manifestVersion": "0.15",
  "id": "local.dsh-auto-update",
  "name": "DSH 自动更新（Auto Update）",
  "version": "0.4.0",
  "facets": {
    "host": {
      "entry": "lib/index.js",
      "apiVersion": "v1alpha1"
    }
  },
  "requires": {
    "contracts": [
      {
        "apiVersion": "webserver.dsh/v1alpha1",
        "kind": "HttpPrefixRoutes",
        "optional": false
      },
      {
        "apiVersion": "browser.ui.dsh/v1alpha1",
        "kind": "ContributionHost",
        "optional": true
      }
    ]
  },
  "permissions": [
    {
      "name": "shell.exec",
      "scope": "git / pnpm 命令，工作目录为 harness 主仓库及其 $DSH_HOME/dsh-auto-update/slots 下的全新试运行副本（主仓库自动探测，可用 DSH_UPDATE_REPO 覆盖）",
      "reason": "检测上游更新，为每次更新新建 worktree 并执行 pnpm install + pnpm run build，用 --version 预检候选入口"
    },
    {
      "name": "fs.write",
      "scope": "harness 主仓库（.git、worktree 元数据）以及 $DSH_HOME/dsh-auto-update/**（试运行副本、运行指针 runtime.json、切换状态、禁用列表、缓存）",
      "reason": "创建/更新蓝绿试运行副本、记录回滚点与运行版本、保存切换结果和临时禁用列表"
    },
    {
      "name": "net.egress",
      "scope": "https://github.com/deepseek-ai/deepseek-harness（经由 git fetch）",
      "reason": "查询上游是否有新提交"
    },
    {
      "name": "process.control",
      "scope": "dsh web 自身进程；端口上已确认属于 dsh web 的残留进程；仅在用户点「让 dsh 帮忙修复」时启动的 headless dsh 修复会话",
      "reason": "「重启生效」由独立切换器按「先启动校验、失败回滚」完成切换；「让 dsh 帮忙修复」按用户点击启动一个后台 dsh 会话读取失败报告，日志写到 $DSH_HOME/dsh-auto-update/failures/"
    }
  ],
  "contributes": {
    "commands": [],
    "x-dev.dsh-std.extensions": [
      {
        "id": "local.dsh-auto-update.browser",
        "apiVersion": "browser.ui.dsh/v1alpha1",
        "kind": "LocalModule",
        "name": "browser",
        "spec": {
          "module": "lib/client.js",
          "requirements": []
        }
      },
      {
        "id": "local.dsh-auto-update.settings-row",
        "apiVersion": "browser.ui.dsh/v1alpha1",
        "kind": "SettingsGeneralItemSlot",
        "name": "auto-update",
        "spec": {
          "slot": "settings.general.item",
          "id": "auto-update",
          "order": 30,
          "note": "设置 → 通用 里的一行；id 为自有值，不会覆盖内置行"
        }
      },
      {
        "id": "local.dsh-auto-update.routes",
        "apiVersion": "webserver.dsh/v1alpha1",
        "kind": "HttpPrefixRoutes",
        "name": "dsh-updater",
        "spec": {
          "prefix": "/dsh-updater",
          "endpoints": [
            "GET /api/state",
            "POST /api/check",
            "POST /api/update",
            "POST /api/cancel",
            "POST /api/restart",
            "POST /api/plugins/retry",
            "GET /api/failure",
            "POST /api/failure/clear",
            "POST /api/assist"
          ]
        }
      }
    ]
  },
  "license": "MIT",
  "x-dsh-transition": {
    "activation": "当前 entry 为 Cordis 插件形状（exports { apply, inject, name }）",
    "clientInject": [
      "@deepseek-ai/dsh-client-runtime",
      "@deepseek-ai/dsh-client-locale",
      "@deepseek-ai/dsh-client-ui-conversation"
    ],
    "bundlePatch": "cordis.patch.yml"
  },
  "source": {
    "repository": "https://github.com/heshuren371/dsh-auto-update"
  }
}