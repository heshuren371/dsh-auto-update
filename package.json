{
  "name": "@local/dsh-auto-update",
  "version": "0.1.3",
  "private": true,
  "description": "在「设置 → 通用」里一键检测并更新 DeepSeek Harness：git pull + pnpm install + pnpm run build，带进度日志、回滚点与重启。",
  "license": "MIT",
  "author": "heshuren371",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "scripts/install.mjs",
    "scripts/restart-web.sh",
    "scripts/build-demo.mjs",
    "dsh-plugin.json",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "docs/DESIGN.md",
    "docs/settings-general.png"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/heshuren371/dsh-auto-update.git"
  },
  "homepage": "https://github.com/heshuren371/dsh-auto-update#readme",
  "bugs": {
    "url": "https://github.com/heshuren371/dsh-auto-update/issues"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "auto-update",
    "updater",
    "cordis"
  ]
}
