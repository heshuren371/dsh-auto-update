{
  "name": "@local/dsh-auto-update",
  "version": "0.3.0",
  "private": true,
  "description": "在「设置 → 通用」里一键检测并更新 DeepSeek Harness：在蓝绿副本里构建、用真实 profile 试运行、通过后由独立切换器安全重启，失败自动回滚。",
  "license": "MIT",
  "author": "heshuren371",
  "type": "module",
  "main": "lib/index.js",
  "scripts": {
    "test": "node scripts/selftest.mjs && node scripts/clienttest.mjs",
    "test:client": "node scripts/clienttest.mjs",
    "test:switch": "node scripts/switchtest.mjs",
    "test:pipeline": "node scripts/selftest.mjs --pipeline"
  },
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/util.js",
    "lib/probe.js",
    "scripts/install.mjs",
    "scripts/switch.mjs",
    "scripts/selftest.mjs",
    "scripts/switchtest.mjs",
    "scripts/clienttest.mjs",
    "scripts/use-managed-dsh.mjs",
    "scripts/restart-web.sh",
    "scripts/build-demo.mjs",
    "dsh-plugin.json",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "docs/DESIGN.md",
    "docs/settings-general.png"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/heshuren371/dsh-auto-update.git"
  },
  "homepage": "https://github.com/heshuren371/dsh-auto-update#readme",
  "bugs": {
    "url": "https://github.com/heshuren371/dsh-auto-update/issues"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "auto-update",
    "updater",
    "cordis"
  ]
}